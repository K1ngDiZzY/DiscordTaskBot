# Discord Task Bot — Environment Variables
# Copy this file to .env and fill in your values.

# Your Discord bot token (required)
DISCORD_TOKEN=your-bot-token-here

# (Optional) Restrict the bot to a specific Discord server ID for instant slash-command sync.
# Leave blank to sync globally (takes up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Path to the SQLite database file (default: data/tasks.db)
DATABASE_PATH=data/tasks.db

# How often (in seconds) the reminder loop checks for due reminders (default: 60)
REMINDER_POLL_SECONDS=60

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
